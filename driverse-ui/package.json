{
	"name": "@driverse/ui",
	"version": "0.1.0",
	"description": "Shared UI library extracted from the Driverse Autocredit and Business frontends",
	"type": "module",
	"private": false,
	"license": "UNLICENSED",
	"packageManager": "pnpm@10.29.3",
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "lefthook"]
	},
	"engines": {
		"node": ">=20"
	},
	"sideEffects": ["**/*.css", "**/*.css.ts"],
	"files": ["dist"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tokens": {
			"types": "./dist/tokens/index.d.ts",
			"default": "./dist/tokens/index.js"
		},
		"./tailwind-preset": {
			"types": "./dist/tailwind/preset.d.ts",
			"default": "./dist/tailwind/preset.js"
		},
		"./icons/offline": {
			"types": "./dist/icons/iconify-bundle.d.ts",
			"default": "./dist/icons/iconify-bundle.js"
		},
		"./highlight": {
			"types": "./dist/utils/highlight.d.ts",
			"default": "./dist/utils/highlight.js"
		},
		"./charts": {
			"types": "./dist/charts/index.d.ts",
			"default": "./dist/charts/index.js"
		},
		"./data-table": {
			"types": "./dist/data-table/index.d.ts",
			"default": "./dist/data-table/index.js"
		},
		"./editor": {
			"types": "./dist/editor/index.d.ts",
			"default": "./dist/editor/index.js"
		},
		"./pdf": {
			"types": "./dist/pdf/index.d.ts",
			"default": "./dist/pdf/index.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"default": "./dist/i18n/index.js"
		},
		"./features/fleet-tracking-map": {
			"types": "./dist/features/fleet-tracking-map/index.d.ts",
			"default": "./dist/features/fleet-tracking-map/index.js"
		},
		"./features/multi-tabs": {
			"types": "./dist/features/multi-tabs/index.d.ts",
			"default": "./dist/features/multi-tabs/index.js"
		},
		"./features/document-inbox": {
			"types": "./dist/features/document-inbox/index.d.ts",
			"default": "./dist/features/document-inbox/index.js"
		},
		"./features/telemetry": {
			"types": "./dist/features/telemetry/index.d.ts",
			"default": "./dist/features/telemetry/index.js"
		},
		"./features/vehicle-compliance": {
			"types": "./dist/features/vehicle-compliance/index.d.ts",
			"default": "./dist/features/vehicle-compliance/index.js"
		},
		"./features/vehicle-insurance": {
			"types": "./dist/features/vehicle-insurance/index.d.ts",
			"default": "./dist/features/vehicle-insurance/index.js"
		},
		"./styles.css": "./dist/driverse-ui.css"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsc --noEmit && vite build --config vite.lib.config.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"status": "node scripts/gen-status.mjs",
		"check": "pnpm lint && pnpm build && pnpm test && pnpm build-storybook"
	},
